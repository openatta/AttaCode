# AttaCode 环境变量模板。
#
# 使用：复制为 .env（本仓库 .gitignore 已排除，不会被提交）并填实际值。
# crates/bridge/src/bootstrap.rs 直接从进程环境读取这些变量，不会自动
# 加载 .env 文件 —— 运行前需要先 source 它：
#   set -a; . .env; set +a
#   cargo run -p app

# === 必填 ===

# Anthropic API key。也可以填第三方 Anthropic-compatible 端的 key（如 DeepSeek）。
# ANTHROPIC_AUTH_TOKEN 和 ANTHROPIC_API_KEY 二选一，优先读 ANTHROPIC_AUTH_TOKEN。
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_API_KEY=

# === 可选 ===

# 自定义 API base URL。指向 Anthropic 之外的 Anthropic-compat 端时用。
# 已知可用：
#   - 默认（不填）：https://api.anthropic.com
#   - DeepSeek Anthropic-compat：https://api.deepseek.com/anthropic
ANTHROPIC_BASE_URL=

# 模型 id（不填时 crates/app 默认用 claude-sonnet-4-6）。
# 指向 DeepSeek 端点时通常填 deepseek-v4-flash。
ANTHROPIC_MODEL=

# 日志（tracing-subscriber EnvFilter 语法）
RUST_LOG=warn,bridge=info,app=info
